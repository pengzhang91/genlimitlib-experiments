import Stage3Model
import GenLimit.Paper39_DenseGeneration.Abstract.PartialDensity
import Mathlib

open Set
open Filter

namespace Stage3Case017Proof

open GenLimit

variable {m : ℕ}

abbrev CaseStream := Stage3Case017.Stream
abbrev CaseGenerator := Stage3Case017.OnlineGenerator

/-- GenLimit.Languages still compatible with the finite input history. -/
def PrefixCompatible (family : Fin m → GenLimit.Language) {t : ℕ}
    (history : Fin (t + 1) → ℕ) (j : Fin m) : Prop :=
  ∀ i, history i ∈ family j

/-- The common core of the languages compatible with the current history. -/
def prefixCore (family : Fin m → GenLimit.Language) {t : ℕ}
    (history : Fin (t + 1) → ℕ) : GenLimit.Language :=
  {z | ∀ j, PrefixCompatible family history j → z ∈ family j}

/-- Values unavailable at the current round. -/
def unavailable {t : ℕ} (input : Fin (t + 1) → ℕ)
    (output : Fin t → ℕ) : Finset ℕ :=
  Finset.univ.image input ∪ Finset.univ.image output

/-- Choose the least fresh point of the current core when one exists; otherwise
choose an arbitrary globally fresh point. -/
noncomputable def chooseOutput (family : Fin m → GenLimit.Language) {t : ℕ}
    (input : Fin (t + 1) → ℕ) (output : Fin t → ℕ) : ℕ := by
  classical
  let used := unavailable input output
  if h : ∃ z, z ∈ prefixCore family input ∧ z ∉ used then
    exact Nat.find h
  else
    exact Classical.choose (Finset.exists_not_mem used)

noncomputable def onlineGenerator (family : Fin m → GenLimit.Language) : CaseGenerator :=
  fun _ input output => chooseOutput family input output

/-- Finite output history obtained by iterating an online generator. -/
def outputHistory (gen : CaseGenerator) (input : CaseStream) :
    (t : ℕ) → Fin t → ℕ
  | 0 => Fin.elim0
  | t + 1 => Fin.lastCases
      (gen t (fun i => input i) (outputHistory gen input t))
      (outputHistory gen input t)

/-- The stream generated by the iterated finite histories. -/
def trajectory (gen : CaseGenerator) (input : CaseStream) : CaseStream :=
  fun t => outputHistory gen input (t + 1) (Fin.last t)

@[simp] theorem outputHistory_last (gen : CaseGenerator) (input : CaseStream)
    (t : ℕ) :
    outputHistory gen input (t + 1) (Fin.last t) =
      gen t (fun i => input i) (outputHistory gen input t) := by
  simp [outputHistory]

@[simp] theorem outputHistory_castSucc (gen : CaseGenerator) (input : CaseStream)
    {t : ℕ} (i : Fin t) :
    outputHistory gen input (t + 1) i.castSucc =
      outputHistory gen input t i := by
  simp [outputHistory]

 theorem outputHistory_eq_trajectory (gen : CaseGenerator) (input : CaseStream)
    {t : ℕ} (i : Fin t) :
    outputHistory gen input t i = trajectory gen input i := by
  induction t with
  | zero => exact Fin.elim0 i
  | succ t ih =>
      refine Fin.lastCases ?_ (fun k => ?_) i
      · simp [trajectory]
      · simpa [trajectory, outputHistory] using ih k

 theorem trajectory_follows (gen : CaseGenerator) (input : CaseStream) :
    Stage3Case017.Follows gen input (trajectory gen input) := by
  intro t
  rw [trajectory, outputHistory_last]
  congr
  funext i
  exact outputHistory_eq_trajectory gen input i

 theorem chooseOutput_not_unavailable (family : Fin m → GenLimit.Language) {t : ℕ}
    (input : Fin (t + 1) → ℕ) (output : Fin t → ℕ) :
    chooseOutput family input output ∉ unavailable input output := by
  classical
  simp only [chooseOutput]
  split
  · exact (Nat.find_spec ‹∃ z, z ∈ prefixCore family input ∧
      z ∉ unavailable input output›).2
  · exact Classical.choose_spec
      (Finset.exists_not_mem (unavailable input output))

 theorem chooseOutput_mem_core_of_exists (family : Fin m → GenLimit.Language) {t : ℕ}
    (input : Fin (t + 1) → ℕ) (output : Fin t → ℕ)
    (h : ∃ z, z ∈ prefixCore family input ∧
      z ∉ unavailable input output) :
    chooseOutput family input output ∈ prefixCore family input := by
  classical
  simp [chooseOutput, h, Nat.find_spec h]

 theorem chooseOutput_le_of_available (family : Fin m → GenLimit.Language) {t : ℕ}
    (input : Fin (t + 1) → ℕ) (output : Fin t → ℕ) {z : ℕ}
    (hcore : z ∈ prefixCore family input)
    (hfresh : z ∉ unavailable input output) :
    chooseOutput family input output ≤ z := by
  classical
  have hex : ∃ w, w ∈ prefixCore family input ∧
      w ∉ unavailable input output := ⟨z, hcore, hfresh⟩
  simp only [chooseOutput]
  rw [dif_pos hex]
  exact Nat.find_min' hex ⟨hcore, hfresh⟩

 theorem trajectory_fresh_input (family : Fin m → GenLimit.Language) (input : CaseStream)
    (t s : ℕ) (hs : s ≤ t) :
    input s ≠ trajectory (onlineGenerator family) input t := by
  intro heq
  have hnot := chooseOutput_not_unavailable family
    (fun i : Fin (t + 1) => input i)
    (outputHistory (onlineGenerator family) input t)
  apply hnot
  apply Finset.mem_union_left
  apply Finset.mem_image.mpr
  refine ⟨⟨s, Nat.lt_succ_of_le hs⟩, Finset.mem_univ _, ?_⟩
  simpa [trajectory, onlineGenerator] using heq

 theorem trajectory_injective (family : Fin m → GenLimit.Language) (input : CaseStream) :
    Function.Injective (trajectory (onlineGenerator family) input) := by
  intro s t hst
  by_contra hne
  rcases lt_or_gt_of_ne hne with hlt | hgt
  · have hnot := chooseOutput_not_unavailable family
      (fun i : Fin (t + 1) => input i)
      (outputHistory (onlineGenerator family) input t)
    apply hnot
    apply Finset.mem_union_right
    apply Finset.mem_image.mpr
    refine ⟨⟨s, hlt⟩, Finset.mem_univ _, ?_⟩
    calc
      outputHistory (onlineGenerator family) input t ⟨s, hlt⟩ =
          trajectory (onlineGenerator family) input s :=
        outputHistory_eq_trajectory _ _ _
      _ = trajectory (onlineGenerator family) input t := hst
      _ = chooseOutput family (fun i : Fin (t + 1) => input i)
          (outputHistory (onlineGenerator family) input t) := by
        simp [trajectory, onlineGenerator]
  · have hnot := chooseOutput_not_unavailable family
      (fun i : Fin (s + 1) => input i)
      (outputHistory (onlineGenerator family) input s)
    apply hnot
    apply Finset.mem_union_right
    apply Finset.mem_image.mpr
    refine ⟨⟨t, hgt⟩, Finset.mem_univ _, ?_⟩
    calc
      outputHistory (onlineGenerator family) input s ⟨t, hgt⟩ =
          trajectory (onlineGenerator family) input t :=
        outputHistory_eq_trajectory _ _ _
      _ = trajectory (onlineGenerator family) input s := hst.symm
      _ = chooseOutput family (fun i : Fin (s + 1) => input i)
          (outputHistory (onlineGenerator family) input s) := by
        simp [trajectory, onlineGenerator]

/-- A common threshold after which finite-prefix compatibility is exact. -/
 theorem exists_missing_index (family : Fin m → GenLimit.Language)
    (input : CaseStream) (j : Fin m)
    (h : ¬ GenLimit.Generic.StreamIn input (family j)) :
    ∃ n, input n ∉ family j := by
  rw [GenLimit.Generic.StreamIn, Set.not_subset] at h
  obtain ⟨z, ⟨n, rfl⟩, hz⟩ := h
  exact ⟨n, hz⟩

noncomputable def eliminationTime (family : Fin m → GenLimit.Language)
    (input : CaseStream) (j : Fin m) : ℕ := by
  classical
  exact if h : GenLimit.Generic.StreamIn input (family j) then 0
    else Classical.choose (exists_missing_index family input j h) + 1

noncomputable def stabilizationTime (family : Fin m → GenLimit.Language)
    (input : CaseStream) : ℕ := by
  classical
  exact Finset.univ.sup (eliminationTime family input)

 theorem le_stabilizationTime (family : Fin m → GenLimit.Language) (input : CaseStream)
    (j : Fin m) :
    eliminationTime family input j ≤ stabilizationTime family input := by
  classical
  exact Finset.le_sup (s := Finset.univ) (f := eliminationTime family input)
    (Finset.mem_univ j)

 theorem prefixCompatible_iff (family : Fin m → GenLimit.Language) (input : CaseStream)
    {t : ℕ} (ht : stabilizationTime family input ≤ t) (j : Fin m) :
    PrefixCompatible family (fun i : Fin (t + 1) => input i) j ↔
      GenLimit.Generic.StreamIn input (family j) := by
  classical
  constructor
  · intro hp z hzrange
    obtain ⟨n, rfl⟩ := hzrange
    by_contra hn
    have hnot : ¬ GenLimit.Generic.StreamIn input (family j) := by
      intro hall
      exact hn (hall ⟨n, rfl⟩)
    have hw := Classical.choose_spec (exists_missing_index family input j hnot)
    have hle := le_stabilizationTime family input j
    rw [eliminationTime, dif_neg hnot] at hle
    have hnle : Classical.choose (exists_missing_index family input j hnot) ≤ t := by omega
    exact hw (hp ⟨_, Nat.lt_succ_of_le hnle⟩)
  · intro hall i
    exact hall ⟨i, rfl⟩

 theorem prefixCore_eq_informationCore (family : Fin m → GenLimit.Language)
    (input : CaseStream) {t : ℕ} (ht : stabilizationTime family input ≤ t) :
    prefixCore family (fun i : Fin (t + 1) => input i) =
      Stage3Case017.informationCore family input := by
  ext z
  simp only [prefixCore, Stage3Case017.informationCore, Set.mem_setOf_eq]
  constructor <;> intro hz j hj
  · exact hz j ((prefixCompatible_iff family input ht j).2 hj)
  · exact hz j ((prefixCompatible_iff family input ht j).1 hj)

 theorem core_has_fresh (family : Fin m → GenLimit.Language) (input : CaseStream)
    (hcore : (Stage3Case017.informationCore family input).Infinite) (t : ℕ)
    (ht : stabilizationTime family input ≤ t) :
    ∃ z, z ∈ prefixCore family (fun i : Fin (t + 1) => input i) ∧
      z ∉ unavailable (fun i : Fin (t + 1) => input i)
        (outputHistory (onlineGenerator family) input t) := by
  rw [prefixCore_eq_informationCore family input ht]
  exact hcore.exists_not_mem_finset _

 theorem trajectory_mem_core (family : Fin m → GenLimit.Language) (input : CaseStream)
    (hcore : (Stage3Case017.informationCore family input).Infinite) {t : ℕ}
    (ht : stabilizationTime family input ≤ t) :
    trajectory (onlineGenerator family) input t ∈ Stage3Case017.informationCore family input := by
  have hex := core_has_fresh family input hcore t ht
  have hmem := chooseOutput_mem_core_of_exists family
    (fun i : Fin (t + 1) => input i)
    (outputHistory (onlineGenerator family) input t) hex
  rw [prefixCore_eq_informationCore family input ht] at hmem
  simpa [trajectory, outputHistory_last] using hmem

 theorem trajectory_le_available_core (family : Fin m → GenLimit.Language)
    (input : CaseStream) {t z : ℕ}
    (ht : stabilizationTime family input ≤ t)
    (hcore : z ∈ Stage3Case017.informationCore family input)
    (hfreshInput : ∀ s, s ≤ t → input s ≠ z)
    (hfreshOutput : ∀ s, s < t → trajectory (onlineGenerator family) input s ≠ z) :
    trajectory (onlineGenerator family) input t ≤ z := by
  have hprefix : z ∈ prefixCore family
      (fun i : Fin (t + 1) => input i) := by
    rw [prefixCore_eq_informationCore family input ht]
    exact hcore
  have hunavailable : z ∉ unavailable
      (fun i : Fin (t + 1) => input i)
      (outputHistory (onlineGenerator family) input t) := by
    intro hz
    rcases Finset.mem_union.mp hz with hz | hz
    · obtain ⟨i, -, hi⟩ := Finset.mem_image.mp hz
      exact hfreshInput i (Nat.le_of_lt_succ i.isLt) hi
    · obtain ⟨i, -, hi⟩ := Finset.mem_image.mp hz
      exact hfreshOutput i i.isLt (by
        simpa [outputHistory_eq_trajectory] using hi)
  have hle := chooseOutput_le_of_available family
    (fun i : Fin (t + 1) => input i)
    (outputHistory (onlineGenerator family) input t) hprefix hunavailable
  simpa [trajectory, outputHistory_last] using hle

/-- Every core point never presented by the input is eventually output. -/
 theorem core_diff_range_subset_output_range (family : Fin m → GenLimit.Language)
    (input : CaseStream) (hcore : (Stage3Case017.informationCore family input).Infinite) :
    Stage3Case017.informationCore family input \ Set.range input ⊆
      Set.range (trajectory (onlineGenerator family) input) := by
  intro z hz
  by_contra hnot
  have hneverOut : ∀ t, trajectory (onlineGenerator family) input t ≠ z := by
    intro t ht
    exact hnot ⟨t, ht⟩
  let T := stabilizationTime family input
  let block : Finset ℕ := Finset.range (z + 2)
  let times : Finset ℕ := block.image (fun q => T + q)
  let values : Finset ℕ := times.image (trajectory (onlineGenerator family) input)
  have hcardTimes : times.card = z + 2 := by
    rw [Finset.card_image_of_injective]
    · simp [block]
    · exact fun a b hab => by omega
  have hcardValues : values.card = z + 2 := by
    rw [Finset.card_image_of_injective]
    · exact hcardTimes
    · exact trajectory_injective family input
  have hsubset : values ⊆ Finset.range (z + 1) := by
    intro y hy
    obtain ⟨t, htTimes, rfl⟩ := Finset.mem_image.mp hy
    obtain ⟨q, hqBlock, rfl⟩ := Finset.mem_image.mp htTimes
    apply Finset.mem_range.mpr
    have hle : trajectory (onlineGenerator family) input (T + q) ≤ z := by
      apply trajectory_le_available_core family input
      · exact Nat.le_add_right T q
      · exact hz.1
      · intro s hs heq
        exact hz.2 ⟨s, heq⟩
      · intro s hs heq
        exact hneverOut s heq
    omega
  have := Finset.card_le_card hsubset
  rw [hcardValues, Finset.card_range] at this
  omega

 theorem output_range_eq_generatorFirst (family : Fin m → GenLimit.Language)
    (input : CaseStream) :
    Set.range (trajectory (onlineGenerator family) input) =
      GenLimit.GeneratorFirst input
        (trajectory (onlineGenerator family) input) := by
  ext z
  constructor
  · rintro ⟨t, rfl⟩
    exact ⟨t, rfl, trajectory_fresh_input family input t⟩
  · rintro ⟨t, ht, -⟩
    exact ⟨t, ht⟩

 theorem core_covered (family : Fin m → GenLimit.Language) (input : CaseStream)
    (hcore : (Stage3Case017.informationCore family input).Infinite) :
    Stage3Case017.informationCore family input ⊆
      GenLimit.AdversaryFirst input (trajectory (onlineGenerator family) input) ∪
      GenLimit.GeneratorFirst input (trajectory (onlineGenerator family) input) := by
  intro z hz
  by_cases hrange : z ∈ Set.range input
  · exact GenLimit.range_subset_first_announcements input
      (trajectory (onlineGenerator family) input) hrange
  · apply Set.mem_union_right
    rw [← output_range_eq_generatorFirst family input]
    exact core_diff_range_subset_output_range family input hcore ⟨hz, hrange⟩

/-- First input time, totalized outside the input range. -/
noncomputable def firstInputTime (input : CaseStream) (z : ℕ) : ℕ := by
  classical
  exact if h : ∃ t, input t = z then Nat.find h else 0

 theorem firstInputTime_spec' (family : Fin m → GenLimit.Language) {input : CaseStream} {z : ℕ}
    (hz : z ∈ GenLimit.AdversaryFirst input
      (trajectory (onlineGenerator family) input)) :
    input (firstInputTime input z) = z := by
  classical
  obtain ⟨t, ht, -⟩ := hz
  have hex : ∃ q, input q = z := ⟨t, ht⟩
  rw [firstInputTime, dif_pos hex]
  exact Nat.find_spec hex

 theorem firstInputTime_min (family : Fin m → GenLimit.Language) {input : CaseStream}
    {z t : ℕ}
    (hz : z ∈ GenLimit.AdversaryFirst input
      (trajectory (onlineGenerator family) input))
    (ht : input t = z) : firstInputTime input z ≤ t := by
  classical
  obtain ⟨w, hw, -⟩ := hz
  simp only [firstInputTime]
  rw [dif_pos ⟨w, hw⟩]
  exact Nat.find_min' ⟨w, hw⟩ ht

noncomputable def earlyAttacker (family : Fin m → GenLimit.Language)
    (input : CaseStream) : Finset ℕ := by
  classical
  exact (GenLimit.Generic.sample input (stabilizationTime family input + 1)).filter
    (fun z => z ∈ GenLimit.AdversaryFirst input
      (trajectory (onlineGenerator family) input))

noncomputable def predecessorPartner (family : Fin m → GenLimit.Language)
    (input : CaseStream) (z : ℕ) : ℕ :=
  trajectory (onlineGenerator family) input (firstInputTime input z - 1)

 theorem stabilization_lt_firstInputTime (family : Fin m → GenLimit.Language)
    (input : CaseStream) {target : GenLimit.Language} {z : ℕ}
    (hz : z ∈ GenLimit.PatientScope.ordinaryAttacker target
      (GenLimit.AdversaryFirst input (trajectory (onlineGenerator family) input))
      ∅ (earlyAttacker family input)) :
    stabilizationTime family input < firstInputTime input z := by
  have hzA := hz.1.1
  have hnotEarly : z ∉ earlyAttacker family input := by
    intro hearly
    exact hz.2 (Set.mem_union_left _ hearly)
  by_contra hnot
  apply hnotEarly
  classical
  simp only [earlyAttacker, Finset.mem_filter]
  refine ⟨?_, hzA⟩
  rw [GenLimit.Generic.mem_sample_iff]
  exact ⟨firstInputTime input z, Nat.lt_succ_of_le (Nat.le_of_not_gt hnot),
    firstInputTime_spec' family hzA⟩

 theorem predecessor_mem (family : Fin m → GenLimit.Language) (input : CaseStream)
    (hcore : (Stage3Case017.informationCore family input).Infinite) {target : GenLimit.Language}
    (hcoreTarget : Stage3Case017.informationCore family input ⊆ target) {z : ℕ}
    (hz : z ∈ GenLimit.PatientScope.ordinaryAttacker target
      (GenLimit.AdversaryFirst input (trajectory (onlineGenerator family) input))
      ∅ (earlyAttacker family input)) :
    predecessorPartner family input z ∈
      GenLimit.GeneratorFirst input (trajectory (onlineGenerator family) input) ∩ target := by
  have htime := stabilization_lt_firstInputTime family input hz
  have hmemCore := trajectory_mem_core family input hcore (by omega :
    stabilizationTime family input ≤ firstInputTime input z - 1)
  refine ⟨?_, hcoreTarget hmemCore⟩
  rw [← output_range_eq_generatorFirst family input]
  exact ⟨firstInputTime input z - 1, rfl⟩

 theorem predecessor_lt (family : Fin m → GenLimit.Language) (input : CaseStream)
    (hinputInCore : Set.range input ⊆ Stage3Case017.informationCore family input)
    {target : GenLimit.Language} {z : ℕ}
    (hz : z ∈ GenLimit.PatientScope.ordinaryAttacker target
      (GenLimit.AdversaryFirst input (trajectory (onlineGenerator family) input))
      ∅ (earlyAttacker family input)) :
    predecessorPartner family input z < z := by
  have hzA := hz.1.1
  have htime := stabilization_lt_firstInputTime family input hz
  have hzEq := firstInputTime_spec' family hzA
  have hzCore : z ∈ Stage3Case017.informationCore family input := hinputInCore ⟨_, hzEq⟩
  have hle : trajectory (onlineGenerator family) input
      (firstInputTime input z - 1) ≤ z := by
    apply trajectory_le_available_core family input
    · omega
    · exact hzCore
    · intro s hs heq
      have hmin := firstInputTime_min family hzA heq
      omega
    · intro s hs heq
      obtain ⟨w, hw, hbefore⟩ := hzA
      have hmin := firstInputTime_min family ⟨w, hw, hbefore⟩ hw
      exact hbefore s (lt_of_lt_of_le hs (by omega)) heq
  have hne : predecessorPartner family input z ≠ z := by
    intro heq
    obtain ⟨w, hw, hbefore⟩ := hzA
    have hmin := firstInputTime_min family ⟨w, hw, hbefore⟩ hw
    exact hbefore (firstInputTime input z - 1) (by omega) heq
  exact Nat.lt_of_le_of_ne hle hne

 theorem predecessor_injective (family : Fin m → GenLimit.Language) (input : CaseStream)
    {target : GenLimit.Language} :
    Set.InjOn (predecessorPartner family input)
      (GenLimit.PatientScope.ordinaryAttacker target
        (GenLimit.AdversaryFirst input (trajectory (onlineGenerator family) input))
        ∅ (earlyAttacker family input)) := by
  intro x hx y hy hxy
  have htx := stabilization_lt_firstInputTime family input hx
  have hty := stabilization_lt_firstInputTime family input hy
  have hpred : firstInputTime input x - 1 = firstInputTime input y - 1 := by
    apply trajectory_injective family input
    exact hxy
  have htime : firstInputTime input x = firstInputTime input y := by omega
  have hxA := hx.1.1
  have hyA := hy.1.1
  calc
    x = input (firstInputTime input x) := (firstInputTime_spec' family hxA).symm
    _ = input (firstInputTime input y) := by rw [htime]
    _ = y := firstInputTime_spec' family hyA

 theorem informationCore_subset_compatible (family : Fin m → GenLimit.Language)
    (input : CaseStream) {j : Fin m}
    (hj : GenLimit.Generic.StreamIn input (family j)) :
    Stage3Case017.informationCore family input ⊆ family j := by
  intro z hz
  exact hz j hj

 theorem input_range_subset_core (family : Fin m → GenLimit.Language) (input : CaseStream) :
    Set.range input ⊆ Stage3Case017.informationCore family input := by
  rintro z ⟨t, rfl⟩ j hj
  exact hj ⟨t, rfl⟩

noncomputable def partialCertificate (family : Fin m → GenLimit.Language)
    (input : CaseStream) (hcore : (Stage3Case017.informationCore family input).Infinite)
    (j : Fin m) (hj : GenLimit.Generic.StreamIn input (family j)) :
    GenLimit.PatientScope.PartialEnumerationCertificate where
  target := family j
  enumerated := Stage3Case017.informationCore family input
  enumerated_subset_target := informationCore_subset_compatible family input hj
  attacker := GenLimit.AdversaryFirst input (trajectory (onlineGenerator family) input)
  defender := GenLimit.GeneratorFirst input (trajectory (onlineGenerator family) input)
  output := trajectory (onlineGenerator family) input
  output_range := output_range_eq_generatorFirst family input
  output_injective := trajectory_injective family input
  validFrom := stabilizationTime family input
  eventual_target := fun t ht =>
    informationCore_subset_compatible family input hj
      (trajectory_mem_core family input hcore ht)
  enumerated_covered := core_covered family input hcore
  attacker_subset_target := by
    intro z hz
    obtain ⟨t, rfl, -⟩ := hz
    exact hj ⟨t, rfl⟩
  ownership_disjoint := GenLimit.adversaryFirst_disjoint_generatorFirst _ _
  earlyAttacker := earlyAttacker family input
  switchLoss := ∅
  switchLoss_subset := by simp
  partner := predecessorPartner family input
  partner_mem := fun z hz => predecessor_mem family input hcore
    (informationCore_subset_compatible family input hj) hz
  partner_lt := fun z hz => predecessor_lt family input
    (input_range_subset_core family input) hz
  partner_injective := predecessor_injective family input
  switchBudget := fun _ => 0
  switch_prefix_le := by
    intro n
    change GenLimit.PatientScope.prefixCount (∅ : Set ℕ) n ≤ 0
    simp [GenLimit.PatientScope.prefixCount,
      GenLimit.PatientScope.prefixFinset]

 theorem half_core_density (family : Fin m → GenLimit.Language) (input : CaseStream)
    (hcore : (Stage3Case017.informationCore family input).Infinite) (j : Fin m)
    (hj : GenLimit.Generic.StreamIn input (family j)) :
    (1 / 2 : ℝ) *
        GenLimit.PatientScope.relativeLowerDensity
          (Stage3Case017.informationCore family input) (family j) ≤
      GenLimit.PatientScope.relativeLowerDensity
        (GenLimit.GeneratorFirst input (trajectory (onlineGenerator family) input) ∩
          family j) (family j) := by
  let P := partialCertificate family input hcore j hj
  have hlog : ∀ n, GenLimit.PatientScope.prefixCount P.switchLoss n ≤
      Nat.log2 (P.targetCount n) := by
    intro n
    change GenLimit.PatientScope.prefixCount (∅ : Set ℕ) n ≤ _
    simp [GenLimit.PatientScope.prefixCount,
      GenLimit.PatientScope.prefixFinset]
  have h := GenLimit.PatientScope.PartialEnumerationCertificate.theorem_3_17
    P ((Set.Infinite.mono (informationCore_subset_compatible family input hj)) hcore)
    hlog
  simpa [P, GenLimit.PatientScope.PartialEnumerationCertificate.lowerDensity]
    using h

 theorem relativeLowerDensity_mono {A B K : GenLimit.Language}
    (hAB : A ⊆ B) (hBK : B ⊆ K) :
    GenLimit.PatientScope.relativeLowerDensity A K ≤
      GenLimit.PatientScope.relativeLowerDensity B K := by
  unfold GenLimit.PatientScope.relativeLowerDensity
  apply liminf_le_liminf
  · exact Filter.Eventually.of_forall fun n =>
      div_le_div_of_nonneg_right
        (by exact_mod_cast GenLimit.PatientScope.prefixCount_mono hAB n)
        (Nat.cast_nonneg _)
  · exact isBoundedUnder_of
      ⟨0, fun n => div_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _)⟩
  · exact isCoboundedUnder_ge_of_le atTop (x := (1 : ℝ)) (fun n => by
        by_cases hn : GenLimit.PatientScope.prefixCount K n = 0
        · simp [hn]
        · rw [div_le_one (by exact_mod_cast Nat.pos_of_ne_zero hn)]
          exact_mod_cast GenLimit.PatientScope.prefixCount_mono
            hBK n)

 theorem never_presented_density (family : Fin m → GenLimit.Language) (input : CaseStream)
    (hcore : (Stage3Case017.informationCore family input).Infinite) (j : Fin m)
    (hj : GenLimit.Generic.StreamIn input (family j)) :
    GenLimit.PatientScope.relativeLowerDensity
        (Stage3Case017.informationCore family input \ Set.range input) (family j) ≤
      GenLimit.PatientScope.relativeLowerDensity
        (GenLimit.GeneratorFirst input (trajectory (onlineGenerator family) input) ∩
          family j) (family j) := by
  apply relativeLowerDensity_mono
  · intro z hz
    refine ⟨?_, informationCore_subset_compatible family input hj hz.1⟩
    rw [← output_range_eq_generatorFirst family input]
    exact core_diff_range_subset_output_range family input hcore hz
  · exact Set.inter_subset_right

 theorem trajectory_novel (family : Fin m → GenLimit.Language) (input : CaseStream)
    (hcore : (Stage3Case017.informationCore family input).Infinite) (j : Fin m)
    (hj : GenLimit.Generic.StreamIn input (family j)) :
    GenLimit.NovelGeneratesInLimit input
      (trajectory (onlineGenerator family) input) (family j) := by
  refine ⟨stabilizationTime family input, ?_⟩
  intro t ht
  refine ⟨informationCore_subset_compatible family input hj
      (trajectory_mem_core family input hcore ht), ?_, ?_⟩
  · intro hsample
    rw [GenLimit.mem_sample_iff] at hsample
    obtain ⟨s, hs, heq⟩ := hsample
    exact trajectory_fresh_input family input t s (Nat.le_of_lt_succ hs) heq
  · intro s hs
    intro heq
    exact (Nat.ne_of_lt hs) ((trajectory_injective family input) heq)

end Stage3Case017Proof
